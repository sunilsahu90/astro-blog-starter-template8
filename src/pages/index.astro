  description: cfg.tagline,
};

const words = (s) => s.split(' ');
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{cfg.brand} | MBBS in Russia, Kyrgyzstan & India | Medical Counselling Nagpur</title>
  <meta name="description" content="Medical admission counselling by Dr. Lokesh Raut, Nagpur. MBBS in Russia and Kyrgyzstan, MBBS/BDS/BAMS/BHMS in India, paramedical courses and FMGE/NExT guidance with one-call response." />
  <meta name="theme-color" content="#06b6d4" />
  <meta property="og:title" content={`${cfg.brand} | Medical Counselling`} />
  <meta property="og:description" content={cfg.tagline} />
  <meta property="og:type" content="website" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🩺</text></svg>" />
  <link rel="preconnect" href="https://flagcdn.com" crossorigin />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body>
  <!-- Preloader: pure CSS, hides itself even if JS fails -->
  <div id="pre" aria-hidden="true">
    <div class="pre-in">
      <div class="pre-name">
        {words(cfg.owner).map((w, wi) => (
          <span class="w">{[...w].map((c, i) => <span class="ch" style={`--i:${i + wi * 4};--base:.1s`}>{c}</span>)}</span>
        ))}
      </div>
      <svg class="pre-ecg" viewBox="0 0 300 50"><path d="M0 25 H95 L110 6 L130 44 L148 14 L160 25 H300" /></svg>
      <p>Medical Counselling</p>
    </div>
  </div>

  <div id="bar" class="bar"></div>
  <div class="bg" aria-hidden="true">
    <span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span>
    <span class="float f1">✚</span><span class="float f2">💊</span><span class="float f3">✚</span><span class="float f4">🧬</span><span class="float f5">✚</span><span class="float f6">🩺</span>
  </div>

  <header id="nav" class="nav">
    <a href="#home" class="logo"><span class="logo-mark">✚</span><span>{cfg.brand}</span></a>
    <nav id="menu" class="menu" aria-label="Main">
      <a href="#abroad">MBBS Abroad</a>
      <a href="#india">India Courses</a>
      <a href="#why">Why Us</a>
      <a href="#process">Process</a>
      <a href="#insta">Instagram</a>
      <a href="#faq">FAQ</a>
      <a href="#contact" class="btn btn-sm mag">Free Counselling</a>
    </nav>
    <button id="burger" class="burger" aria-label="Toggle menu" aria-expanded="false" aria-controls="menu"><span></span><span></span><span></span></button>
  </header>

  <main>
    <!-- HERO -->
    <section id="home" class="hero">
      <div class="hero-text">
        <span class="pill reveal">🩺 Medical admission counselling · Nagpur</span>
        <h1 style="--base:1.25s" aria-label="Ask Dr. Lokesh">
          {words('Ask Dr.').map((w, wi) => (
            <span class="w" aria-hidden="true">{[...w].map((c, i) => <span class="ch" style={`--i:${i + wi * 3}`}>{c}</span>)}</span>
          ))}
          <br />
          <span class="w name" aria-hidden="true">{[...'Lokesh'].map((c, i) => <span class="ch" style={`--i:${i + 7}`}>{c}</span>)}</span>
        </h1>
        <p class="lead reveal" style="--d:1.5s">Your MBBS dream, guided honestly. <b>Russia · Kyrgyzstan · India</b>, plus support through every year of your course and FMGE / NExT preparation help.</p>
        <div class="cta reveal" style="--d:1.65s">
          <a href="#contact" class="btn mag">Book Free Counselling</a>
          <a href={`https://wa.me/${cfg.whatsapp}`} target="_blank" rel="noopener" class="btn btn-wa mag"><span class="i" set:html={ico.chat}></span>WhatsApp Now</a>
        </div>
        <ul class="trust reveal" style="--d:1.8s">
          <li>⚡ One-call response</li>
          <li>🤝 Support till graduation</li>
          <li>🧑‍⚕️ FMGE / NExT guidance</li>
        </ul>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div class="dna-wrap">
          <div class="dna">
            {Array.from({ length: 18 }, (_, i) => (
              <div class="rung" style={`--i:${i}`}><i></i><b></b><i></i></div>
            ))}
          </div>
          <div class="chipf cf1" data-depth="26"><img src="https://flagcdn.com/w40/ru.png" width="22" height="16" alt="" loading="lazy" onerror="this.style.display='none'" /> MBBS Russia</div>
          <div class="chipf cf2" data-depth="-20"><img src="https://flagcdn.com/w40/kg.png" width="22" height="16" alt="" loading="lazy" onerror="this.style.display='none'" /> MBBS Kyrgyzstan</div>
          <div class="chipf cf3" data-depth="32"><img src="https://flagcdn.com/w40/in.png" width="22" height="16" alt="" loading="lazy" onerror="this.style.display='none'" /> India Courses</div>
          <div class="chipf cf4" data-depth="-28">🧑‍⚕️ FMGE / NExT</div>
        </div>
        <svg class="ecg" viewBox="0 0 400 70" preserveAspectRatio="none"><path d="M0 35 H120 L145 8 L172 62 L196 20 L214 35 H400" /></svg>
      </div>
      <a href="#abroad" class="scroll-cue" aria-label="Scroll down"><span></span></a>
    </section>

    <!-- MARQUEE -->
    <div class="marquee" aria-hidden="true">
      <div class="track">
        {[...russia, ...kyrgyz, ...russia, ...kyrgyz].map((u) => <span>{u.name}</span>)}
      </div>
    </div>

    <!-- STATS -->
    <section class="stats">
      <div class="stat reveal" data-a="zoom"><b data-count="6">0</b><span>Universities featured</span></div>
      <div class="stat reveal" data-a="zoom" style="--d:90ms"><b data-count="2">0</b><span>Countries abroad</span></div>
      <div class="stat reveal" data-a="zoom" style="--d:180ms"><b data-count={indiaCourses.length}>0</b><span>Course options in India</span></div>
      <div class="stat reveal" data-a="zoom" style="--d:270ms"><b data-count="1" data-suffix=" Call">0</b><span>is all it takes to reach us</span></div>
    </section>

    <!-- STUDY ABROAD -->
    <section id="abroad" class="section">
      <div class="head reveal">
        <span class="eyebrow">MBBS Abroad</span>
        <h2>Study medicine at trusted <span class="grad">universities abroad</span></h2>
        <p class="sub">Tap a card to see what we help with. Fees, intake dates and recognition status are shared openly during counselling.</p>
      </div>

      <div class="tabs reveal" role="tablist">
        <button class="tab on" role="tab" data-tab="ru"><img src="https://flagcdn.com/w40/ru.png" width="22" height="16" alt="" loading="lazy" onerror="this.style.display='none'" /> Russia</button>
        <button class="tab" role="tab" data-tab="kg"><img src="https://flagcdn.com/w40/kg.png" width="22" height="16" alt="" loading="lazy" onerror="this.style.display='none'" /> Kyrgyzstan</button>
      </div>

      <div class="panel on" id="p-ru">
        <div class="ugrid">
          {russia.map((u, i) => (
            <article class="flip reveal" data-a="flip" style={`--d:${i * 100}ms`} tabindex="0">
              <div class="flip-in">
                <div class="face front">
                  <div class="crest">{u.short}</div>
                  <h3>{u.name}</h3>
                  <p class="loc"><span class="i" set:html={ico.pin}></span>{u.city}, Russia</p>
                  <span class="tag">MBBS · General Medicine</span>
                  <small class="hint">Tap / hover for details ↻</small>
                </div>
                <div class="face back">
                  <h4>{u.short}</h4>
                  <ul>
                    <li>✔ Fee & intake details</li>
                    <li>✔ Recognition status check</li>
                    <li>✔ Admission, visa & travel</li>
                    <li>✔ Hostel & food guidance</li>
                    <li>✔ FMGE / NExT prep help</li>
                  </ul>
                  <button class="btn btn-sm pickuni" data-uni={u.name} type="button">Enquire now</button>
                </div>
              </div>
            </article>
          ))}
        </div>
        <p class="note">Typical MBBS (General Medicine) duration in Russia is about 6 years. Confirm current details for each university with us.</p>
      </div>

      <div class="panel" id="p-kg">
        <div class="ugrid single">
          {kyrgyz.map((u) => (
            <article class="flip" tabindex="0">
              <div class="flip-in">
                <div class="face front">
                  <div class="crest">{u.short}</div>
                  <h3>{u.name}</h3>
                  <p class="loc"><span class="i" set:html={ico.pin}></span>{u.city}, Kyrgyzstan</p>
                  <span class="tag">MBBS · General Medicine</span>
                  <small class="hint">Tap / hover for details ↻</small>
                </div>
                <div class="face back">
                  <h4>{u.short}</h4>
                  <ul>
                    <li>✔ Fee & intake details</li>
                    <li>✔ Recognition status check</li>
                    <li>✔ Admission, visa & travel</li>
                    <li>✔ Hostel & food guidance</li>
                    <li>✔ FMGE / NExT prep help</li>
                  </ul>
                  <button class="btn btn-sm pickuni" data-uni={u.name} type="button">Enquire now</button>
                </div>
              </div>
            </article>
          ))}
          <div class="kg-info">
            <h3>Why students consider Kyrgyzstan</h3>
            <p>Kyrgyzstan is a popular, budget-conscious destination for Indian medical aspirants. We will walk you through the programme, living costs and recognition checks so you can compare it honestly with Russia and India.</p>
            <a href="#contact" class="btn btn-sm mag">Ask about Kyrgyzstan</a>
          </div>
        </div>
      </div>
    </section>

    <!-- INDIA COURSES -->
    <section id="india" class="section alt">
      <div class="head reveal">
        <span class="eyebrow">Studying in India</span>
        <h2>Medical, dental, AYUSH & <span class="grad">paramedical courses</span></h2>
        <p class="sub">Guidance on counselling rounds, college selection, documents and choice filling for domestic admissions.</p>
      </div>
      <div class="cgrid">
        {indiaCourses.map((c, i) => (
          <article class="ccard tilt reveal" data-a="zoom" style={`--d:${(i % 5) * 70}ms`}>
            <div class="cicon">{c.i}</div>
            <h3>{c.t}</h3>
            <p class="dur">⏱ {c.d}</p>
            <p class="ent">{c.e}</p>
          </article>
        ))}
      </div>
      <p class="note">Durations and eligibility are typical and may vary by state and institution. We confirm the latest rules for you.</p>
    </section>

    <!-- WHY US -->
    <section id="why" class="section">
      <div class="head reveal">
        <span class="eyebrow">Why families choose us</span>
        <h2>Counselling that doesn't end <span class="grad">after admission</span></h2>
      </div>
      <div class="fgrid">
        {features.map((f, i) => (
          <article class="fcard tilt reveal" data-a={i % 2 ? 'right' : 'left'} style={`--d:${(i % 4) * 80}ms`}>
            <div class="ficon">{f.i}</div>
            <div>
              <h3>{f.t}</h3>
              <p>{f.d}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- FMGE BAND -->
    <section class="band">
      <div class="band-in reveal" data-a="zoom">
        <div>
          <span class="eyebrow light">After your degree</span>
          <h2>Practise in India with <span class="u">FMGE / NExT</span> guidance</h2>
          <p>Graduates of foreign medical universities must clear the licensing exam prescribed by NMC to practise in India. From year one, we guide you on study planning, mock tests and updates, so you are exam-ready by the time you graduate.</p>
        </div>
        <a href="#contact" class="btn btn-white mag">Talk to Dr. Lokesh</a>
      </div>
    </section>

    <!-- PROCESS -->
    <section id="process" class="section">
      <div class="head reveal">
        <span class="eyebrow">How it works</span>
        <h2>From first call to <span class="grad">graduation</span>, step by step</h2>
      </div>
      <ol class="tl" id="tl">
        {steps.map((s, i) => (
          <li class="tl-item reveal" data-a={i % 2 ? 'right' : 'left'}>
            <span class="tl-dot">{i + 1}</span>
            <div class="tl-card">
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- ABOUT / PROMISE -->
    <section class="section alt">
      <div class="about">
        <div class="about-card reveal" data-a="left">
          <div class="avatar">DL</div>
          <h3>{cfg.owner}</h3>
          <p class="muted">Medical admission counsellor · Nagpur, Maharashtra</p>
          <div class="soc">
            <a href={`https://www.instagram.com/${cfg.instagram}`} target="_blank" rel="noopener" aria-label="Instagram"><span class="i" set:html={ico.insta}></span></a>
            <a href={`https://wa.me/${cfg.whatsapp}`} target="_blank" rel="noopener" aria-label="WhatsApp"><span class="i" set:html={ico.chat}></span></a>
            <a href={`mailto:${cfg.email}`} aria-label="Email"><span class="i" set:html={ico.mail}></span></a>
            <a href={`tel:+${cfg.whatsapp}`} aria-label="Call"><span class="i" set:html={ico.phone}></span></a>
          </div>
        </div>
        <div class="reveal" data-a="right">
          <span class="eyebrow">Our promise</span>
          <h2 class="h2s">Truthful advice. Clear communication. Support that lasts.</h2>
          <ul class="promise">
            <li>✔ We tell you the pros and cons of every option, even when it isn't the easy sale.</li>
            <li>✔ We never promise guaranteed seats or exam results.</li>
            <li>✔ You and your parents get a direct line to our team, always.</li>
            <li>✔ We stay with you across the full tenure of your course.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="section">
      <div class="head reveal">
        <span class="eyebrow">Good to know</span>
        <h2>Frequently asked <span class="grad">questions</span></h2>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details class="reveal">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- INSTAGRAM FEED -->
    <section id="insta" class="section">
      <div class="head reveal">
        <span class="eyebrow">Follow us on Instagram</span>
        <h2>Latest from <span class="grad">@{cfg.instagram}</span></h2>
        <p class="sub">Admission updates, university life and student stories, straight from our Instagram.</p>
      </div>

      {igPosts.length > 0 && (
        <div class="igwrap">
          {igPosts.map((url, i) => (
            <div class="igcard reveal" data-a="zoom" style={`--d:${i * 90}ms`}>
              <blockquote class="instagram-media" data-instgrm-permalink={url} data-instgrm-version="14">
                <a href={url} target="_blank" rel="noopener">View this post on Instagram</a>
              </blockquote>
            </div>
          ))}
        </div>
      )}

      <div class="igfollow reveal" data-a="zoom">
        <span class="i" set:html={ico.insta}></span>
        <div>
          <b>@{cfg.instagram}</b>
          <small>Follow for daily medical admission updates</small>
        </div>
        <a href={`https://www.instagram.com/${cfg.instagram}`} target="_blank" rel="noopener" class="btn btn-sm mag">Follow on Instagram</a>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="section alt">
      <div class="head reveal">
        <span class="eyebrow">Get in touch</span>
        <h2>Book your <span class="grad">free counselling call</span></h2>
        <p class="sub">Share a few details and we will respond on WhatsApp. Prefer to talk? Call us directly.</p>
      </div>
      <div class="cwrap">
        <div class="cinfo reveal" data-a="left">
          <a class="crow" href={`tel:+${cfg.whatsapp}`}><span class="cic" set:html={ico.phone}></span><div><small>Call / WhatsApp</small><b>{cfg.phoneDisplay}</b></div></a>
          <a class="crow" href={`mailto:${cfg.email}`}><span class="cic" set:html={ico.mail}></span><div><small>Email</small><b>{cfg.email}</b></div></a>
          <a class="crow" href={`https://www.instagram.com/${cfg.instagram}`} target="_blank" rel="noopener"><span class="cic" set:html={ico.insta}></span><div><small>Instagram</small><b>@{cfg.instagram}</b></div></a>
          <div class="crow"><span class="cic" set:html={ico.pin}></span><div><small>Office</small><b>{cfg.address}</b></div></div>
          <div class="map">
            <iframe title="Nagpur map" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=Nagpur%2C%20Maharashtra&z=11&output=embed"></iframe>
