                <optgroup label="India">
                  {indiaCourses.map((c) => <option>{c.t} (India)</option>)}
                </optgroup>
                <optgroup label="Other">
                  <option>FMGE / NExT guidance</option>
                  <option>Not sure, need advice</option>
                </optgroup>
              </select>
