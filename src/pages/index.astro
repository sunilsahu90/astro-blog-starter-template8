        <p class="muted">📍 {cfg.address}</p>
      </div>
      <div>
        <h4>Explore</h4>
        <a href="#abroad">MBBS Abroad</a>
        <a href="#india">India Courses</a>
        <a href="#why">Why Us</a>
        <a href="#process">Process</a>
        <a href="#faq">FAQ</a>
      </div>
      <div>
        <h4>Contact</h4>
        <a href={`tel:+${cfg.whatsapp}`}>{cfg.phoneDisplay}</a>
        <a href={`mailto:${cfg.email}`}>{cfg.email}</a>
        <a href={`https://www.instagram.com/${cfg.instagram}`} target="_blank" rel="noopener">@{cfg.instagram}</a>
      </div>
    </div>
    <p class="disc">Disclaimer: {cfg.brand} provides independent admission guidance and is not an official government or university body. No admission, seat or exam result is guaranteed. University names are as commonly known; fees, intake, eligibility and recognition status can change, so please verify on official NMC and university websites.</p>
    <p class="copy">© {new Date().getFullYear()} {cfg.brand} · {cfg.owner}. All rights reserved.</p>
  </footer>

  <a id="up" class="up" href="#home" aria-label="Back to top"><span class="i" set:html={ico.up}></span></a>
  <a class="wa-float" href={`https://wa.me/${cfg.whatsapp}?text=${encodeURIComponent('Hello Dr. Lokesh, I need medical admission counselling.')}`} target="_blank" rel="noopener" aria-label="Chat on WhatsApp"><span class="i" set:html={ico.chat}></span></a>
  <a class="call-float" href={`tel:+${cfg.whatsapp}`} aria-label="Call now"><span class="i" set:html={ico.phone}></span></a>

  <script>
    const $ = (s, r = document) => r.querySelector(s);
    const $$ = (s, r = document) => [...r.querySelectorAll(s)];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;

    // remove preloader node after it fades
    setTimeout(() => $('#pre')?.remove(), 2400);

    // ----- menu -----
    const burger = $('#burger'), menu = $('#menu');
    burger?.addEventListener('click', () => {
      const o = menu.classList.toggle('open');
      burger.classList.toggle('x', o);
      burger.setAttribute('aria-expanded', String(o));
    });
    $$('#menu a').forEach((a) => a.addEventListener('click', () => {
      menu.classList.remove('open'); burger.classList.remove('x'); burger.setAttribute('aria-expanded', 'false');
    }));

    // ----- scroll: progress bar, nav, back-to-top, timeline -----
    const bar = $('#bar'), nav = $('#nav'), up = $('#up'), tl = $('#tl');
    let ticking = false;
    function onScroll() {
      const y = scrollY, h = document.documentElement.scrollHeight - innerHeight;
      bar.style.transform = `scaleX(${h > 0 ? y / h : 0})`;
      nav.classList.toggle('scrolled', y > 10);
      up.classList.toggle('show', y > 700);
      if (tl) {
        const r = tl.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (innerHeight * 0.65 - r.top) / r.height));
        tl.style.setProperty('--tl', (p * 100).toFixed(1) + '%');
      }
      ticking = false;
    }
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
    onScroll();

    // ----- reveal + counters -----
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('in');
      const c = $('[data-count]', e.target);
      if (c) count(c);
      io.unobserve(e.target);
    }), { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    $$('.reveal').forEach((el) => io.observe(el));

    function count(el) {
      const end = +el.dataset.count, suf = el.dataset.suffix || '';
      if (reduce) { el.textContent = end + suf; return; }
      const t0 = performance.now(), dur = 1400;
      const step = (t) => {
        const p = Math.min(1, (t - t0) / dur);
        el.textContent = Math.round(end * (1 - Math.pow(1 - p, 3))) + suf;
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }

    // ----- tabs -----
    $$('.tab').forEach((b) => b.addEventListener('click', () => {
      $$('.tab').forEach((x) => x.classList.toggle('on', x === b));
      $$('.panel').forEach((p) => p.classList.toggle('on', p.id === 'p-' + b.dataset.tab));
      $$('.panel.on .flip').forEach((f) => f.classList.add('in'));
    }));

    // ----- flip cards (tap on touch / keyboard) -----
    $$('.flip').forEach((f) => {
      f.addEventListener('click', () => f.classList.toggle('flipped'));
      f.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); f.classList.toggle('flipped'); } });
    });

    // ----- enquire buttons prefill form -----
    $$('.pickuni').forEach((b) => b.addEventListener('click', (e) => {
      e.stopPropagation();
      const sel = $('#interest');
      if (sel) sel.value = b.dataset.uni;
      $('#contact').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
    }));

    // ----- 3D tilt -----
    if (fine && !reduce) {
      $$('.tilt').forEach((c) => {
        c.addEventListener('pointermove', (e) => {
          const r = c.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
          c.style.transform = `perspective(800px) rotateY(${x * 10}deg) rotateX(${-y * 10}deg) translateY(-6px)`;
        });
        c.addEventListener('pointerleave', () => (c.style.transform = ''));
      });
      // magnetic buttons
      $$('.mag').forEach((b) => {
        b.addEventListener('pointermove', (e) => {
          const r = b.getBoundingClientRect();
          b.style.transform = `translate(${(e.clientX - r.left - r.width / 2) * 0.18}px, ${(e.clientY - r.top - r.height / 2) * 0.25}px)`;
        });
        b.addEventListener('pointerleave', () => (b.style.transform = ''));
      });
      // hero parallax
      const hero = $('.hero'), chips = $$('.chipf');
      hero?.addEventListener('pointermove', (e) => {
        const x = e.clientX / innerWidth - 0.5, y = e.clientY / innerHeight - 0.5;
        chips.forEach((c) => {
          const d = +c.dataset.depth || 20;
          c.style.translate = `${x * d}px ${y * d}px`;
        });
      });
    }

    // ----- instagram embeds (loads only when the section is near the screen = faster page) -----
    const igSec = $('#insta');
    if (igSec && $('.instagram-media')) {
      const loadIG = () => {
        const s = document.createElement('script');
        s.src = 'https://www.instagram.com/embed.js';
        s.async = true;
        s.onload = () => window.instgrm && window.instgrm.Embeds.process();
        document.body.appendChild(s);
      };
      const ioIG = new IntersectionObserver((es) => {
        if (es[0].isIntersecting) { loadIG(); ioIG.disconnect(); }
      }, { rootMargin: '600px' });
      ioIG.observe(igSec);
    }

    // ----- contact form -----
    const form = $('#askForm'), msgBox = $('#formMsg'), mailBtn = $('#mailBtn');
    function show(m, ok) { msgBox.textContent = m; msgBox.className = 'form-msg ' + (ok ? 'ok' : 'err'); }
    function collect() {
      const f = new FormData(form), v = (k) => String(f.get(k) || '').trim();
      const d = { name: v('name'), phone: v('phone'), email: v('email'), city: v('city'), neet: v('neet'), interest: v('interest'), msg: v('msg') };
      if (d.name.length < 2) return { error: 'Please enter your name.' };
      if (!/^[0-9+\-\s]{10,15}$/.test(d.phone)) return { error: 'Please enter a valid phone number.' };
      if (d.email && !/^\S+@\S+\.\S+$/.test(d.email)) return { error: 'Please enter a valid email or leave it blank.' };
      if (!d.neet) return { error: 'Please select your NEET status.' };
      if (!d.interest) return { error: 'Please select what you are interested in.' };
      const text = `Hello Dr. Lokesh,\n\nName: ${d.name}\nPhone: ${d.phone}\n` + (d.email ? `Email: ${d.email}\n` : '') + (d.city ? `City: ${d.city}\n` : '') +
        `NEET status: ${d.neet}\nInterested in: ${d.interest}\nMessage: ${d.msg || '(not provided)'}`;
      return { d, text };
    }
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const r = collect();
      if (r.error) return show(r.error, false);
      show('Opening WhatsApp… press send to reach us.', true);
      window.open(`https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(r.text)}`, '_blank', 'noopener');
    });
    mailBtn?.addEventListener('click', () => {
      const r = collect();
      if (r.error) return show(r.error, false);
      show('Opening your email app…', true);
      location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Counselling enquiry from ' + r.d.name)}&body=${encodeURIComponent(r.text)}`;
    });
  </script>

  <style is:global>
    :root {
      --ink: #0b2540; --muted: #5b7088; --bg: #f5fbfe; --bg2: #eaf6fb; --card: #fff; --line: #dcecf4;
      --p: #0891b2; --b: #2563eb; --v: #7c3aed; --wa: #25d366; --coral: #ff6b57;
      --grad: linear-gradient(135deg, #06b6d4, #2563eb 60%, #7c3aed);
      --sh: 0 10px 30px rgba(8, 100, 140, .10); --sh2: 0 18px 44px rgba(8, 100, 140, .18);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; scroll-padding-top: 76px; }
    body { font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background: var(--bg); color: var(--ink); line-height: 1.6; overflow-x: hidden; -webkit-font-smoothing: antialiased; }
    a { color: inherit; text-decoration: none; }
    ul, ol { list-style: none; }
    img, svg { display: block; max-width: 100%; }
    h1, h2, h3, h4 { line-height: 1.15; letter-spacing: -.01em; }
    .i { display: inline-flex; width: 1.2em; height: 1.2em; } .i svg { width: 100%; height: 100%; }
    .muted { color: var(--muted); }
    .grad { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }

    /* progress + background */
    .bar { position: fixed; top: 0; left: 0; height: 4px; width: 100%; background: var(--grad); transform: scaleX(0); transform-origin: 0 50%; z-index: 100; will-change: transform; }
    .bg { position: fixed; inset: 0; z-index: -1; overflow: hidden; background: radial-gradient(1200px 600px at 80% -10%, #d8f3fb, transparent), radial-gradient(900px 500px at -10% 30%, #e6e9ff, transparent), var(--bg); }
    .blob { position: absolute; border-radius: 50%; filter: blur(70px); opacity: .5; animation: drift 20s ease-in-out infinite; will-change: transform; }
    .b1 { width: 380px; height: 380px; background: #a5f3fc; top: -60px; left: -60px; }
    .b2 { width: 420px; height: 420px; background: #c7d2fe; top: 40%; right: -120px; animation-delay: -7s; }
    .b3 { width: 340px; height: 340px; background: #bbf7d0; bottom: -80px; left: 30%; animation-delay: -12s; }
    @keyframes drift { 50% { transform: translate(40px, -40px) scale(1.1); } }
    .float { position: absolute; font-size: 1.6rem; opacity: .22; animation: bobf 9s ease-in-out infinite; }
    .f1 { top: 14%; left: 6%; color: var(--p); } .f2 { top: 30%; right: 8%; animation-delay: -2s; } .f3 { top: 62%; left: 4%; color: var(--b); font-size: 2.2rem; animation-delay: -4s; }
    .f4 { top: 78%; right: 10%; animation-delay: -6s; } .f5 { top: 8%; right: 30%; color: var(--coral); animation-delay: -3s; } .f6 { top: 52%; right: 3%; animation-delay: -5s; }
    @keyframes bobf { 0%, 100% { transform: translateY(0) rotate(0); } 50% { transform: translateY(-26px) rotate(14deg); } }

    /* preloader */
    #pre { position: fixed; inset: 0; z-index: 200; background: #fff; display: grid; place-items: center; animation: preOut .55s ease 1.55s forwards; }
    @keyframes preOut { to { opacity: 0; visibility: hidden; } }
    .pre-in { text-align: center; }
    .pre-name { font-size: clamp(2rem, 8vw, 3.6rem); font-weight: 800; perspective: 700px; }
    .pre-name .w { margin: 0 .12em; }
    .pre-ecg { width: min(280px, 70vw); height: 44px; margin: 14px auto 6px; }
    .pre-ecg path { fill: none; stroke: var(--p); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 420; stroke-dashoffset: 420; animation: draw 1.4s ease .2s forwards; }
    .pre-in p { color: var(--muted); letter-spacing: .3em; text-transform: uppercase; font-size: .75rem; font-weight: 600; }
    @keyframes draw { to { stroke-dashoffset: 0; } }

    /* 3D letter entry */
    .w { display: inline-block; white-space: nowrap; margin-right: .22em; perspective: 700px; }
    .ch { display: inline-block; opacity: 0; transform-origin: 50% 100%; transform: rotateX(-100deg) translateY(36px) scale(.8); animation: chIn .9s cubic-bezier(.2, .9, .3, 1.25) forwards; animation-delay: calc(var(--i) * 60ms + var(--base, 1.2s)); }
    @keyframes chIn { to { opacity: 1; transform: none; } }
    .pre-name .ch { color: var(--ink); }
    .pre-name .w:last-child .ch { color: var(--p); }

    /* nav */
    .nav { position: fixed; top: 0; inset-inline: 0; z-index: 90; display: flex; align-items: center; justify-content: space-between; padding: 14px 5vw; transition: background .3s, box-shadow .3s, padding .3s; }
    .nav.scrolled { background: rgba(255, 255, 255, .88); backdrop-filter: blur(14px); box-shadow: 0 4px 24px rgba(8, 100, 140, .09); padding-block: 10px; }
    .logo { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.12rem; }
    .logo-mark { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 11px; background: var(--grad); color: #fff; font-weight: 800; box-shadow: 0 6px 16px rgba(37, 99, 235, .35); animation: beat 2.4s ease-in-out infinite; }
    @keyframes beat { 0%, 100% { transform: scale(1); } 12% { transform: scale(1.14); } 24% { transform: scale(1); } 36% { transform: scale(1.1); } }
    .menu { display: flex; align-items: center; gap: 26px; font-weight: 600; font-size: .93rem; color: #35506b; }
    .menu a:not(.btn) { position: relative; padding: 4px 0; }
    .menu a:not(.btn)::after { content: ''; position: absolute; left: 0; bottom: -2px; height: 2px; width: 0; background: var(--grad); transition: width .3s; }
    .menu a:not(.btn):hover::after { width: 100%; }
    .burger { display: none; background: none; border: 0; cursor: pointer; width: 42px; height: 42px; flex-direction: column; justify-content: center; align-items: center; gap: 6px; }
    .burger span { width: 24px; height: 2.5px; background: var(--ink); border-radius: 2px; transition: .3s; }
    .burger.x span:nth-child(1) { transform: translateY(8.5px) rotate(45deg); } .burger.x span:nth-child(2) { opacity: 0; } .burger.x span:nth-child(3) { transform: translateY(-8.5px) rotate(-45deg); }

    /* buttons */
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 13px 26px; border-radius: 999px; font: inherit; font-weight: 700; font-size: .96rem; color: #fff; background: var(--grad); border: 0; cursor: pointer; box-shadow: 0 10px 26px rgba(37, 99, 235, .3); transition: box-shadow .25s, transform .2s ease-out; position: relative; overflow: hidden; }
    .btn::after { content: ''; position: absolute; inset: 0; background: linear-gradient(110deg, transparent 30%, rgba(255, 255, 255, .45) 50%, transparent 70%); transform: translateX(-120%); transition: transform .6s; }
    .btn:hover::after { transform: translateX(120%); }
    .btn:hover { box-shadow: 0 14px 34px rgba(37, 99, 235, .42); }
    .btn-sm { padding: 9px 20px; font-size: .88rem; }
    .btn-wa { background: linear-gradient(135deg, #34e27a, #14b85a); box-shadow: 0 10px 26px rgba(37, 211, 102, .35); }
    .btn-ghost { background: #fff; color: var(--p); border: 1.5px solid var(--line); box-shadow: none; }
    .btn-white { background: #fff; color: var(--b); box-shadow: 0 10px 28px rgba(0, 0, 0, .18); }
    .btn-block { width: 100%; }

    /* hero */
    .hero { position: relative; min-height: 100vh; display: grid; grid-template-columns: 1.05fr .95fr; gap: 30px; align-items: center; padding: 120px 5vw 70px; max-width: 1280px; margin: 0 auto; }
    .pill { display: inline-block; padding: 8px 16px; background: #fff; border: 1px solid var(--line); border-radius: 999px; font-size: .84rem; font-weight: 600; color: var(--p); box-shadow: var(--sh); margin-bottom: 20px; }
    .hero h1 { font-size: clamp(2.8rem, 8vw, 5.6rem); font-weight: 900; margin-bottom: 20px; }
    .hero h1 .name .ch { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: .01em; }
    .lead { font-size: 1.12rem; color: var(--muted); max-width: 540px; margin-bottom: 28px; }
    .lead b { color: var(--ink); }
    .cta { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 26px; }
    .trust { display: flex; flex-wrap: wrap; gap: 8px 22px; font-weight: 600; font-size: .9rem; color: #35506b; }

    .hero-art { position: relative; min-height: 460px; display: grid; place-items: center; }
    .dna-wrap { position: relative; width: 100%; height: 440px; perspective: 900px; display: grid; place-items: center; animation: bobf2 6s ease-in-out infinite; }
    @keyframes bobf2 { 50% { transform: translateY(-12px); } }
    .dna { position: relative; width: 170px; height: 400px; transform-style: preserve-3d; animation: dnaSpin 14s linear infinite; }
    @keyframes dnaSpin { to { transform: rotateY(360deg); } }
    .rung { position: absolute; left: 0; top: calc(var(--i) * 22.5px); width: 170px; height: 16px; display: flex; align-items: center; justify-content: space-between; transform: rotateY(calc(var(--i) * 21deg)); transform-style: preserve-3d; }
    .rung b { flex: 1; height: 3px; margin: 0 -4px; background: linear-gradient(90deg, #06b6d4, #c7d2fe, #7c3aed); opacity: .55; border-radius: 3px; }
    .rung i { width: 16px; height: 16px; border-radius: 50%; background: radial-gradient(circle at 30% 30%, #67e8f9, #0891b2); box-shadow: 0 0 14px rgba(8, 145, 178, .6); }
    .rung i:last-child { background: radial-gradient(circle at 30% 30%, #a5b4fc, #7c3aed); box-shadow: 0 0 14px rgba(124, 58, 237, .55); }
    .chipf { position: absolute; display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 16px; background: rgba(255, 255, 255, .92); border: 1px solid var(--line); box-shadow: var(--sh2); font-weight: 700; font-size: .86rem; white-space: nowrap; animation: bobf2 5s ease-in-out infinite; transition: translate .25s ease-out; }
    .cf1 { top: 6%; left: 2%; } .cf2 { top: 30%; right: -2%; animation-delay: -1.5s; } .cf3 { bottom: 24%; left: -2%; animation-delay: -3s; } .cf4 { bottom: 4%; right: 6%; animation-delay: -2s; }
    .ecg { position: absolute; bottom: 0; width: 100%; height: 60px; opacity: .85; }
    .ecg path { fill: none; stroke: var(--p); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 520; stroke-dashoffset: 520; animation: draw2 3.2s linear infinite; filter: drop-shadow(0 0 5px rgba(8, 145, 178, .5)); }
    @keyframes draw2 { 55% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: -520; } }
    .scroll-cue { position: absolute; bottom: 18px; left: 50%; width: 26px; height: 42px; margin-left: -13px; border: 2px solid #9ec2d4; border-radius: 14px; }
    .scroll-cue span { position: absolute; top: 8px; left: 50%; width: 4px; height: 8px; margin-left: -2px; border-radius: 3px; background: var(--p); animation: wheel 1.6s infinite; }
    @keyframes wheel { 0% { opacity: 1; transform: translateY(0); } 100% { opacity: 0; transform: translateY(16px); } }

    /* marquee */
    .marquee { overflow: hidden; background: var(--grad); padding: 14px 0; transform: rotate(-1deg) scale(1.03); box-shadow: var(--sh); }
    .track { display: flex; gap: 40px; width: max-content; animation: slide 36s linear infinite; }
    .track span { color: #fff; font-weight: 700; white-space: nowrap; letter-spacing: .02em; }
    .track span::before { content: '✚'; margin-right: 16px; opacity: .8; }
    @keyframes slide { to { transform: translateX(-50%); } }

    /* stats */
    .stats { max-width: 1100px; margin: 70px auto 0; padding: 0 5vw; display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 18px; }
    .stat { text-align: center; padding: 26px 16px; background: #fff; border: 1px solid var(--line); border-radius: 22px; box-shadow: var(--sh); }
    .stat b { display: block; font-size: 2.7rem; font-weight: 900; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; line-height: 1.1; }
    .stat span { color: var(--muted); font-weight: 600; font-size: .9rem; }

    /* sections */
    .section { padding: 96px 5vw; max-width: 1240px; margin: 0 auto; content-visibility: auto; contain-intrinsic-size: 1px 800px; }
    .section.alt { max-width: none; background: linear-gradient(180deg, transparent, rgba(234, 246, 251, .9) 15%, rgba(234, 246, 251, .9) 85%, transparent); }
    .section.alt > * { max-width: 1160px; margin-inline: auto; }
    .head { text-align: center; margin-bottom: 46px; }
    .eyebrow { display: inline-block; color: var(--p); font-weight: 800; letter-spacing: .14em; text-transform: uppercase; font-size: .76rem; margin-bottom: 12px; }
    .eyebrow.light { color: #cffafe; }
    .head h2 { font-size: clamp(1.9rem, 4vw, 3rem); font-weight: 900; }
    .sub { color: var(--muted); max-width: 640px; margin: 14px auto 0; }
    .note { text-align: center; color: var(--muted); font-size: .86rem; margin-top: 26px; }

    /* tabs */
    .tabs { display: flex; justify-content: center; gap: 12px; margin-bottom: 36px; }
    .tab { display: inline-flex; align-items: center; gap: 10px; padding: 12px 26px; border-radius: 999px; border: 1.5px solid var(--line); background: #fff; font: inherit; font-weight: 700; color: var(--ink); cursor: pointer; transition: .25s; }
    .tab.on { background: var(--grad); color: #fff; border-color: transparent; box-shadow: 0 10px 24px rgba(37, 99, 235, .3); }
    .panel { display: none; } .panel.on { display: block; animation: pIn .5s ease; }
    @keyframes pIn { from { opacity: 0; transform: translateY(16px); } }

    /* flip university cards */
    .ugrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px; }
    .ugrid.single { grid-template-columns: minmax(260px, 340px) 1fr; align-items: center; }
    .flip { perspective: 1000px; height: 320px; cursor: pointer; outline: none; }
    .flip-in { position: relative; width: 100%; height: 100%; transition: transform .8s cubic-bezier(.2, .8, .2, 1); transform-style: preserve-3d; }
    .flip:hover .flip-in, .flip.flipped .flip-in, .flip:focus-visible .flip-in { transform: rotateY(180deg); }
    .face { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; border-radius: 24px; padding: 26px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 10px; background: #fff; border: 1px solid var(--line); box-shadow: var(--sh2); }
    .front .crest { width: 78px; height: 78px; border-radius: 50%; display: grid; place-items: center; background: var(--grad); color: #fff; font-weight: 900; font-size: .95rem; box-shadow: 0 10px 24px rgba(37, 99, 235, .35); animation: bobf2 4s ease-in-out infinite; }
    .front h3 { font-size: 1.12rem; }
    .loc { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-weight: 600; font-size: .9rem; }
    .tag { padding: 5px 14px; border-radius: 999px; background: #e0f7fb; color: var(--p); font-weight: 700; font-size: .78rem; }
    .hint { color: #8aa3b8; margin-top: 4px; }
    .back { transform: rotateY(180deg); background: linear-gradient(160deg, #e6fbff, #eef0ff); }
    .back h4 { font-size: 1.3rem; color: var(--b); }
    .back ul { text-align: left; font-weight: 600; font-size: .92rem; display: grid; gap: 5px; }
    .kg-info { padding: 12px 8px 12px 24px; } .kg-info h3 { font-size: 1.4rem; margin-bottom: 10px; } .kg-info p { color: var(--muted); margin-bottom: 18px; }

    /* india course cards */
    .cgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 20px; }
    .ccard { padding: 26px 22px; background: #fff; border: 1px solid var(--line); border-radius: 22px; box-shadow: var(--sh); transition: transform .2s ease-out, box-shadow .3s; position: relative; overflow: hidden; }
    .ccard::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: var(--grad); transform: scaleX(0); transform-origin: left; transition: transform .4s; }
    .ccard:hover::before { transform: scaleX(1); } .ccard:hover { box-shadow: var(--sh2); }
    .cicon { width: 54px; height: 54px; display: grid; place-items: center; font-size: 1.7rem; background: #e8f8fc; border-radius: 16px; margin-bottom: 14px; }
    .ccard h3 { font-size: 1.1rem; margin-bottom: 6px; } .dur { font-weight: 600; font-size: .88rem; color: #35506b; } .ent { font-size: .82rem; color: var(--muted); margin-top: 3px; }

    /* features */
    .fgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(330px, 1fr)); gap: 20px; }
    .fcard { display: flex; gap: 18px; padding: 24px; background: #fff; border: 1px solid var(--line); border-radius: 22px; box-shadow: var(--sh); transition: transform .2s ease-out, box-shadow .3s; }
    .fcard:hover { box-shadow: var(--sh2); }
    .ficon { flex: none; width: 56px; height: 56px; display: grid; place-items: center; font-size: 1.7rem; border-radius: 18px; background: linear-gradient(135deg, #dff7fc, #e8e9ff); }
    .fcard h3 { font-size: 1.05rem; margin-bottom: 4px; } .fcard p { color: var(--muted); font-size: .92rem; }

    /* band */
    .band { padding: 40px 5vw; }
    .band-in { max-width: 1160px; margin: 0 auto; padding: 54px clamp(24px, 5vw, 64px); border-radius: 32px; background: var(--grad); color: #fff; display: flex; align-items: center; justify-content: space-between; gap: 30px; flex-wrap: wrap; box-shadow: 0 24px 60px rgba(37, 99, 235, .35); position: relative; overflow: hidden; }
    .band-in::before, .band-in::after { content: ''; position: absolute; border-radius: 50%; background: rgba(255, 255, 255, .12); animation: drift 14s ease-in-out infinite; }
    .band-in::before { width: 260px; height: 260px; top: -90px; right: 12%; } .band-in::after { width: 180px; height: 180px; bottom: -70px; left: 30%; animation-delay: -5s; }
    .band-in > * { position: relative; z-index: 1; } .band-in > div { max-width: 700px; }
    .band h2 { font-size: clamp(1.7rem, 3.4vw, 2.5rem); margin-bottom: 12px; } .band p { opacity: .92; } .band .u { text-decoration: underline wavy rgba(255, 255, 255, .6); text-underline-offset: 6px; }

    /* timeline */
    .tl { --tl: 0%; position: relative; max-width: 900px; margin: 0 auto; padding-left: 0; display: grid; gap: 26px; }
    .tl::before, .tl::after { content: ''; position: absolute; left: 50%; top: 0; width: 4px; margin-left: -2px; border-radius: 4px; }
    .tl::before { bottom: 0; background: #d8eaf3; } .tl::after { height: var(--tl); background: var(--grad); }
    .tl-item { position: relative; width: 50%; padding-right: 46px; }
    .tl-item:nth-child(even) { margin-left: 50%; padding-right: 0; padding-left: 46px; }
    .tl-dot { position: absolute; right: -19px; top: 18px; width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: var(--grad); color: #fff; font-weight: 800; box-shadow: 0 0 0 6px var(--bg), 0 8px 18px rgba(37, 99, 235, .35); z-index: 1; }
    .tl-item:nth-child(even) .tl-dot { right: auto; left: -19px; }
    .tl-card { background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 20px 22px; box-shadow: var(--sh); transition: transform .3s, box-shadow .3s; }
    .tl-card:hover { transform: translateY(-4px); box-shadow: var(--sh2); }
    .tl-card h3 { font-size: 1.05rem; margin-bottom: 4px; } .tl-card p { color: var(--muted); font-size: .92rem; }

    /* about */
    .about { display: grid; grid-template-columns: .8fr 1.2fr; gap: 48px; align-items: center; }
    .about-card { text-align: center; padding: 38px 28px; background: #fff; border: 1px solid var(--line); border-radius: 28px; box-shadow: var(--sh2); }
    .avatar { width: 120px; height: 120px; margin: 0 auto 16px; border-radius: 50%; display: grid; place-items: center; font-size: 2.4rem; font-weight: 900; color: #fff; background: var(--grad); box-shadow: 0 0 0 8px #e3f6fb, 0 16px 34px rgba(37, 99, 235, .35); animation: bobf2 5s ease-in-out infinite; }
    .about-card h3 { font-size: 1.4rem; }
    .soc { display: flex; justify-content: center; gap: 12px; margin-top: 18px; }
    .soc a { width: 46px; height: 46px; display: grid; place-items: center; border-radius: 50%; background: #e8f8fc; color: var(--p); transition: .25s; }
    .soc a:hover { background: var(--grad); color: #fff; transform: translateY(-4px) rotate(8deg); }
    .h2s { font-size: clamp(1.6rem, 3vw, 2.3rem); font-weight: 900; margin-bottom: 18px; }
    .promise { display: grid; gap: 12px; font-weight: 600; color: #35506b; }

    /* faq */
    .faq { max-width: 820px; margin: 0 auto; display: grid; gap: 14px; }
    details { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 18px 22px; box-shadow: var(--sh); transition: border-color .25s, box-shadow .25s; }
    details[open] { border-color: #8fd8e8; box-shadow: var(--sh2); }
    summary { cursor: pointer; font-weight: 700; list-style: none; display: flex; justify-content: space-between; gap: 14px; }
    summary::-webkit-details-marker { display: none; }
    summary::after { content: '+'; font-size: 1.5rem; line-height: 1; color: var(--p); transition: transform .3s; }
    details[open] summary::after { transform: rotate(45deg); }
    details p { margin-top: 12px; color: var(--muted); animation: pIn .4s ease; }

    /* contact */
    .cwrap { display: grid; grid-template-columns: .9fr 1.1fr; gap: 36px; align-items: start; }
    .cinfo { display: grid; gap: 14px; }
    .crow { display: flex; align-items: center; gap: 16px; padding: 16px 18px; background: #fff; border: 1px solid var(--line); border-radius: 18px; box-shadow: var(--sh); transition: transform .25s, box-shadow .25s; }
    a.crow:hover { transform: translateX(6px); box-shadow: var(--sh2); }
    .cic { flex: none; width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; background: var(--grad); color: #fff; padding: 12px; }
    .cic svg { width: 100%; height: 100%; }
    .crow small { display: block; color: var(--muted); font-weight: 600; font-size: .78rem; } .crow b { font-size: .98rem; word-break: break-word; }
    .map { border-radius: 20px; overflow: hidden; border: 1px solid var(--line); box-shadow: var(--sh); height: 220px; }
    .map iframe { width: 100%; height: 100%; border: 0; }
    .form { padding: 30px; background: #fff; border: 1px solid var(--line); border-radius: 26px; box-shadow: var(--sh2); display: grid; gap: 16px; }
    .row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .form label { display: grid; gap: 7px; font-size: .84rem; font-weight: 700; color: #35506b; }
    .form input, .form select, .form textarea { width: 100%; padding: 13px 15px; border-radius: 13px; border: 1.5px solid var(--line); background: #f8fcfe; color: var(--ink); font: inherit; font-weight: 500; transition: border-color .2s, box-shadow .2s, background .2s; }
    .form input:focus, .form select:focus, .form textarea:focus { outline: 0; border-color: var(--p); background: #fff; box-shadow: 0 0 0 4px rgba(8, 145, 178, .14); }
    .form textarea { resize: vertical; }
    .form-msg { min-height: 20px; font-size: .9rem; font-weight: 700; } .form-msg.err { color: #dc2626; } .form-msg.ok { color: #0d9a4d; }

    /* instagram feed */
    .igwrap { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 22px; align-items: start; }
    .igcard { background: #fff; border: 1px solid var(--line); border-radius: 22px; box-shadow: var(--sh); padding: 10px; display: flex; justify-content: center; overflow: hidden; min-height: 200px; transition: box-shadow .3s, transform .3s; }
    .igcard:hover { box-shadow: var(--sh2); }
    .igcard .instagram-media { margin: 0 auto !important; min-width: 0 !important; width: 100% !important; max-width: 540px !important; border-radius: 14px !important; }
    .igfollow { max-width: 640px; margin: 36px auto 0; display: flex; align-items: center; gap: 16px; padding: 18px 22px; background: #fff; border: 1px solid var(--line); border-radius: 22px; box-shadow: var(--sh); flex-wrap: wrap; justify-content: center; text-align: center; }
    .igfollow > .i { width: 46px; height: 46px; padding: 11px; border-radius: 14px; color: #fff; background: linear-gradient(45deg, #f9ce34, #ee2a7b 55%, #6228d7); }
    .igfollow b { display: block; font-size: 1.05rem; } .igfollow small { color: var(--muted); font-weight: 600; }

    /* footer */
    .footer { margin-top: 40px; padding: 56px 5vw 26px; background: #0b2540; color: #cfe3f1; }
    .foot { max-width: 1160px; margin: 0 auto; display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 34px; }
    .footer .logo { color: #fff; } .footer .muted { color: #9fb7cb; margin-top: 10px; font-size: .92rem; }
    .footer h4 { color: #fff; margin-bottom: 12px; } .footer a:not(.logo) { display: block; padding: 4px 0; color: #cfe3f1; font-size: .93rem; transition: color .2s, padding .2s; }
    .footer a:not(.logo):hover { color: #67e8f9; padding-left: 6px; }
    .disc { max-width: 1160px; margin: 34px auto 0; padding-top: 22px; border-top: 1px solid rgba(255, 255, 255, .12); color: #8fa8bd; font-size: .8rem; }
    .copy { text-align: center; margin-top: 18px; color: #8fa8bd; font-size: .82rem; }

    /* floating buttons */
    .wa-float, .call-float, .up { position: fixed; right: 18px; z-index: 95; display: grid; place-items: center; border-radius: 50%; color: #fff; box-shadow: 0 10px 26px rgba(0, 0, 0, .25); }
    .wa-float { bottom: 18px; width: 60px; height: 60px; background: linear-gradient(135deg, #34e27a, #14b85a); animation: bobf2 2.8s ease-in-out infinite; }
    .wa-float::before { content: ''; position: absolute; inset: 0; border-radius: 50%; background: var(--wa); animation: ring 2s ease-out infinite; z-index: -1; }
    @keyframes ring { to { transform: scale(1.8); opacity: 0; } }
    .wa-float .i { width: 30px; height: 30px; }
    .call-float { bottom: 90px; width: 50px; height: 50px; background: var(--grad); } .call-float .i { width: 24px; height: 24px; }
    .up { bottom: 152px; width: 44px; height: 44px; background: #fff; color: var(--p); border: 1px solid var(--line); opacity: 0; transform: translateY(14px); pointer-events: none; transition: .3s; }
    .up.show { opacity: 1; transform: none; pointer-events: auto; }

    /* reveal variants */
    .reveal { opacity: 0; transform: translateY(34px); transition: opacity .8s ease var(--d, 0ms), transform .8s cubic-bezier(.2, .8, .2, 1) var(--d, 0ms); }
    .reveal[data-a='left'] { transform: translateX(-60px); } .reveal[data-a='right'] { transform: translateX(60px); }
    .reveal[data-a='zoom'] { transform: scale(.82); } .reveal[data-a='flip'] { transform: rotateX(40deg) translateY(40px); transform-origin: 50% 100%; }
    .reveal.in { opacity: 1; transform: none; }
    .tilt.reveal.in { transition: opacity .8s ease var(--d, 0ms), transform .2s ease-out, box-shadow .3s; }

    /* responsive */
    @media (max-width: 920px) {
      .hero { grid-template-columns: 1fr; text-align: center; padding-top: 104px; }
      .lead { margin-inline: auto; } .cta, .trust { justify-content: center; }
      .hero-art { min-height: 400px; } .dna-wrap { height: 400px; } .scroll-cue { display: none; }
      .cwrap, .about, .foot, .ugrid.single { grid-template-columns: 1fr; }
      .kg-info { padding: 8px 0; }
      .burger { display: flex; }
      .menu { position: absolute; top: 100%; left: 0; right: 0; flex-direction: column; align-items: stretch; gap: 0; background: rgba(255, 255, 255, .98); box-shadow: 0 16px 30px rgba(8, 100, 140, .12); max-height: 0; overflow: hidden; transition: max-height .4s ease; }
      .menu.open { max-height: 440px; }
      .menu a:not(.btn) { padding: 15px 5vw; border-top: 1px solid var(--line); } .menu a:not(.btn)::after { display: none; }
      .menu .btn { margin: 14px 5vw 18px; }
      .section { padding: 72px 5vw; }
      .tl::before, .tl::after { left: 19px; margin: 0; }
      .tl-item, .tl-item:nth-child(even) { width: 100%; margin-left: 0; padding: 0 0 0 58px; }
      .tl-dot, .tl-item:nth-child(even) .tl-dot { left: 0; right: auto; }
      .reveal[data-a='left'], .reveal[data-a='right'] { transform: translateY(30px); }
    }
    @media (max-width: 540px) {
      .row { grid-template-columns: 1fr; } .form { padding: 22px; } .fgrid { grid-template-columns: 1fr; }
      .chipf { font-size: .74rem; padding: 8px 12px; } .cf1 { left: -2%; } .cf2 { right: -4%; } .flip { height: 300px; }
      .wa-float { width: 56px; height: 56px; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
      .reveal { opacity: 1; transform: none; } .ch { opacity: 1; transform: none; } #pre { display: none; }
    }
  </style>
</body>
