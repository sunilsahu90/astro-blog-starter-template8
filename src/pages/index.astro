          </div>
          <label>Your message
            <textarea name="msg" rows="4" placeholder="NEET score, category, budget, doubts..."></textarea>
          </label>
          <p id="formMsg" class="form-msg" role="alert" aria-live="polite"></p>
          <button type="submit" class="btn btn-wa btn-block mag"><span class="i" set:html={ico.chat}></span>Send on WhatsApp</button>
          <button type="button" id="mailBtn" class="btn btn-ghost btn-block">Send by email instead</button>
        </form>
      </div>
    </section>
  </main>

